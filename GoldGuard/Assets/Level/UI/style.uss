.shopButton {
    width: 100%;
    height: 100%;
    display: flex;
    flex-grow: 1;
    opacity: 1;
    visibility: visible;
    background-color: rgba(164, 164, 164, 0.2);
}

.label {
    -unity-font: url('project://database/Assets/ThirdParty/TextMesh%20Pro/Fonts/alagard.ttf?fileID=12800000&guid=da7226d4b3c6d41a393a12760e66905a&type=3#alagard');
    -unity-font-definition: initial;
    font-size: initial;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    text-shadow: 3px 1px 0 rgba(38, 38, 38, 0);
}
