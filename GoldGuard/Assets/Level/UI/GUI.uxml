                    <ui:Slider picking-mode="Ignore" value="0.5" high-value="1" name="SFXSlider" style="align-items: stretch; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; justify-content: center; flex-grow: 0; width: 60%;" />
