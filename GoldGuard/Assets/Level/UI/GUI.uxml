        <ui:VisualElement style="flex-grow: 1; width: 84%; height: 5%; -unity-text-align: upper-center; align-items: flex-start; white-space: normal; flex-direction: column; justify-content: flex-start; margin-right: 0; margin-left: 0; margin-top: 0; margin-bottom: 0;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: column; align-items: center; justify-content: flex-start; -unity-text-align: upper-center; margin-top: 2%; width: 85%; height: 100%;">
                <ui:Label text="Next wave in 20" display-tooltip-when-elided="true" name="TimerLabel" enable-rich-text="true" class="label" style="opacity: 1; -unity-text-outline-width: 0; color: rgb(255, 255, 255); text-shadow: 4px 3px 0 rgb(0, 0, 0); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: -40px; -unity-text-align: lower-center; align-items: stretch; flex-direction: column; flex-wrap: nowrap; white-space: nowrap; visibility: hidden; font-size: 50%;" />
                <ui:ProgressBar value="0.7" name="TimerProgress" high-value="1" class="label" style="flex-grow: 0; max-width: none; max-height: none; width: 25%; flex-direction: column; align-items: stretch; justify-content: flex-start; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 0; margin-right: 0; margin-top: 4%; margin-bottom: 0; flex-shrink: 0; -unity-text-align: upper-center; text-shadow: 0 0 0 rgb(0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); background-image: none; -unity-font-style: bold; -unity-text-outline-width: 0; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-left-color: rgb(67, 67, 67); border-right-color: rgb(67, 67, 67); border-top-color: rgb(67, 67, 67); border-bottom-color: rgb(67, 67, 67); visibility: hidden;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
